# @ima-jin/auth, @ima-jin/config, and @ima-jin/logger are published to GitHub
# Packages only (not npmjs.org) — see docs/packages/PUBLISHING.md in
# ima-jin/imajin-ai. Installing them requires a token with `read:packages`.
#
# Export it before `pnpm install` (never commit the token itself):
#   export GITHUB_PACKAGES_TOKEN="<a token with read:packages>"
@ima-jin:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
