# --- Runtime ---
PORT=3000
NODE_ENV=development
# Public URL of this app (used to build redirects behind a reverse proxy).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- This app owns no database (Ryan's ruling, 2026-09-22, DECISION #1985->c) ---
# Every survey is a signed media asset; every response is an attestation.
# There is no DATABASE_URL / APP_DB_SCHEMA here on purpose — see FINDINGS.md.

# --- Imajin kernel (the public app surface this app composes; see AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
# AUTH_SERVICE_URL is read directly by the published @ima-jin/auth package
# (requireSessionOrAppToken, verifyAppToken, canonicalize, ...) and MUST
# already include the /auth prefix, e.g. https://dev-jin.imajin.ai/auth.
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
# Same kernel node's media service (asset/`.fair` primitive), used for
# survey-definition documents. See docs/packages/PUBLISHING.md upstream for
# why this is a distinct path prefix on the same node rather than a
# separate host.
MEDIA_SERVICE_URL=https://dev-jin.imajin.ai/media
# Public equivalents, exposed to the browser for the "Sign in with Imajin"
# link (Next.js only bundles NEXT_PUBLIC_* vars client-side).
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai

# --- This app's signing identity (see docs/REGISTRATION.md) ---
# This app never holds its own private key in an env file. Instead it
# fetches its vault-minted signing key at boot via @ima-jin/auth-client's
# loadAppSigningKey() (refs imajin-ai#2411) — see instrumentation.ts and
# src/lib/auth/signing-identity.ts. Used for the same purpose the old raw
# key was (self-signing NODE-WITNESSED legacy-import attestations via
# scripts/import-legacy.ts — never on behalf of a respondent), plus this
# app's own inbound identity.
#
# The kernel node that grants + serves this app's signing key.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# This app's own did:imajin:..., derived from its public key. Required on
# every boot once a local keystore already exists; a true first boot gets
# it back directly from the claim exchange below.
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# This app's public registry id (`app_...`), returned by registration.
NEXT_PUBLIC_IMAJIN_APP_ID=
# Optional, advanced/CI path only: a one-time code from the kernel operator's
# /jin approval card (apps.provision), set here so first boot resolves it
# automatically. The normal operator path (imajin-ai#2427) needs NO env var
# at all — leave this unset, boot the app (it comes up in "unclaimed" mode:
# every route except /claim, /api/claim, /api/health serves a minimal notice
# page), and paste the code at <this app>/claim in the browser instead.
# Delete this from .env.local once used — it's spent either way, and a lost
# keystore needs a fresh code (`reissueClaim: true` rebind).
IMAJIN_APP_CLAIM_CODE=
# Where loadAppSigningKey() persists this app's own bootstrap keypair
# (NEVER the vault signing key itself) between restarts, mode 0600. Optional
# — defaults to ./.imajin/keystore.json. Must be writable, and must never be
# committed or synced anywhere the claim code wasn't also meant to go.
IMAJIN_APP_KEYSTORE=

# --- Attestation type vocabulary (see docs/REGISTRATION.md step 4) ---
# Namespaced under this app's own registered handle, once, via
# POST {AUTH_SERVICE_URL}/api/attestations/types before going live.
DYKIL_RESPONSE_ATTESTATION_TYPE=dykil/survey-response
DYKIL_LEGACY_IMPORT_ATTESTATION_TYPE=dykil/survey-response-legacy-import

# --- Ticket-holder gate (composable boolean, never raw ticket rows) ---
# See src/lib/ticket-gate.ts and FINDINGS.md (gap #2395) — the events app
# does not yet expose a public, app-token-gated boolean endpoint for this,
# so the gate is stubbed behind an interface until it does.
EVENTS_TICKET_GATE_URL=

# --- Legacy import (scripts/import-legacy.ts only; never used by the app at
# request time) ---
# Read-only connection string to the OLD apps/dykil Postgres schema in the
# imajin-ai monorepo, for the one-pass backport script. Dry-run by default.
LEGACY_DATABASE_URL=

# --- Session (shared kernel session cookie fallback of requireSessionOrAppToken) ---
SESSION_COOKIE_SCOPE=host
