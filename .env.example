# dykil — environment contract (AGENTS.md §5: this file is the contract).
#
# THIS FILE is the LOCAL DEVELOPMENT template: `cp .env.example .env.local`.
# For deployed instances start from the matching file instead:
#   .env.dev.example   -> ~/dev/dykil/.env.local   (dev-dykil,  port 3101)
#   .env.prod.example  -> ~/prod/dykil/.env.local  (prod-dykil, port 7101)
# Full reference (every variable, build vs runtime, dev/prod values):
# docs/ENVIRONMENTS.md. `node scripts/check-env.mjs <prod|dev>` validates a
# deployed env file; scripts/__tests__/env-docs.test.ts fails CI if a variable
# the app reads is missing from here or from the docs.
#
# NEVER commit a real .env.local. Placeholders below are shape-only.

# --- Runtime ---
# Listen port. Only used by `pnpm dev`; deployed instances get PORT from the
# pm2 entry in ecosystem.config.cjs (prod 7101, dev 3101).
PORT=3101
# Injected by next/pm2 (`production` for deployed builds). Leave it out of
# deployed env files.
NODE_ENV=development
# Public URL of this app (used to build redirects behind a reverse proxy). The
# HOST is the `aud` used to verify scoped app tokens, so it must match this
# app's registered tokenAudiences.
NEXT_PUBLIC_APP_URL=http://localhost:3101
# Reverse-proxy path prefix (Caddy: jin.imajin.ai/dykil). Set to /dykil by
# next.config.js at build time — not an env-file value.
# NEXT_PUBLIC_BASE_PATH=/dykil

# --- This app owns no database (Ryan's ruling, 2026-09-22, DECISION #1985->c) ---
# Every survey is a signed media asset; every response is an attestation.
# There is no DATABASE_URL / APP_DB_SCHEMA here on purpose — see FINDINGS.md.

# --- Imajin kernel (the public app surface this app composes; AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
# AUTH_SERVICE_URL is read directly by the published @ima-jin/auth package
# (requireSessionOrAppToken, verifyAppToken, canonicalize, ...) and MUST
# already include the /auth prefix, e.g. https://dev-jin.imajin.ai/auth.
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
# Same kernel node's media service (asset/`.fair` primitive), used for
# survey-definition documents. A distinct path prefix on the same node.
MEDIA_SERVICE_URL=https://dev-jin.imajin.ai/media
# Kernel origin for the "Sign in with Imajin" link (`<value>/auth`).
# BUILD-TIME: Next.js only bundles NEXT_PUBLIC_* vars client-side, at build.
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# Selects the kernel session cookie: `dev` -> imajin_session_dev. Set to `dev`
# on dev and local; leave UNSET on prod.
IMAJIN_ENV=dev

# --- This app's signing identity (docs/REGISTRATION.md) ---
# This app never holds its own private key in an env file. Instead it
# fetches its vault-minted signing key at boot via @ima-jin/auth-client's
# loadAppSigningKey() (refs imajin-ai#2411) — see instrumentation.ts and
# src/lib/auth/signing-identity.ts. Used for self-signing NODE-WITNESSED
# legacy-import attestations via scripts/import-legacy.ts — never on behalf of
# a respondent — plus this app's own inbound identity.
#
# The kernel node that grants + serves this app's signing key.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# This app's own did:imajin:..., from registration. Dev and prod each have
# their own. Required on every boot once a local keystore already exists.
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# This app's public registry id (`app_...`), returned by registration.
# Read by no code here (template parity); safe to omit.
NEXT_PUBLIC_IMAJIN_APP_ID=
# Optional, advanced/CI path only: a one-time code from the kernel operator's
# /jin approval card (apps.provision), set here so first boot resolves it
# automatically. The normal operator path (imajin-ai#2427) needs NO env var
# at all — leave this unset, boot the app (it comes up in "unclaimed" mode:
# every route except /claim, /api/claim, /api/health serves a minimal notice
# page), and paste the code at <this app>/claim (i.e. /dykil/claim) in the
# browser instead. Delete this from .env.local once used — it's spent either
# way, and a lost keystore needs a fresh code (`reissueClaim: true` rebind).
IMAJIN_APP_CLAIM_CODE=
# Where loadAppSigningKey() persists this app's own bootstrap keypair
# (NEVER the vault signing key itself) between restarts, mode 0600. Default
# ./.imajin/keystore.json. On a server set an absolute path that survives
# deploys, one per environment. Never commit or sync it.
# IMAJIN_APP_KEYSTORE=
# REMOVED — the app throws at boot if this is set. Do not set it.
# DYKIL_APP_PRIVATE_KEY=

# --- Attestation type vocabulary (see docs/REGISTRATION.md §5) ---
# Namespaced under this app's own registered handle, once, via
# POST {AUTH_SERVICE_URL}/api/attestations/types before going live.
DYKIL_RESPONSE_ATTESTATION_TYPE=dykil/survey-response
DYKIL_LEGACY_IMPORT_ATTESTATION_TYPE=dykil/survey-response-legacy-import

# --- Ticket-holder gate (composable boolean, never raw ticket rows) ---
# See src/lib/ticket-gate.ts. Ticket-gated surveys only (settings.eventId):
# the events service base URL, and the id of the app.authorized attestation
# granting this app `events:read` — the gate (GET {events}/api/events/{id}/access)
# refuses anything but a scoped app token. Both unset => those surveys answer 501.
EVENTS_SERVICE_URL=https://dev-jin.imajin.ai/events
DYKIL_EVENTS_AUTHORIZATION_ID=

# --- Legacy schema (scripts/legacy-baseline.mjs + scripts/import-legacy.ts only;
# never used by the app at request time) ---
# Connection string for the OLD apps/dykil Postgres schema via a READ-ONLY role.
# deploy.sh's baseline step verifies it read-only; the import script backports
# it one time (dry-run by default). Unset it once the legacy data is retired.
LEGACY_DATABASE_URL=

# --- Session (shared kernel session cookie fallback of requireSessionOrAppToken) ---
SESSION_COOKIE_SCOPE=host

# --- Logging (@ima-jin/logger) — stdout only; pm2 captures it ---
# pino level (default info).
# LOG_LEVEL=debug
# Leave these unset: this app never persists logs (AGENTS.md).
# ENABLE_REQUEST_LOG=
# ENABLE_APP_LOG=
# LOG_DB_TRANSPORT=
# APP_LOG_LEVEL=

# --- URL derivation fallbacks (@ima-jin/config) — leave unset ---
# NEXT_PUBLIC_SERVICE_PREFIX=
# NEXT_PUBLIC_DOMAIN=

# --- @ima-jin/auth paths dykil does not exercise — leave unset ---
# ATTESTATION_INTERNAL_API_KEY=
# AUTH_INTERNAL_API_KEY=
# PROFILE_SERVICE_URL=
# PROFILE_INTERNAL_API_KEY=
# NODE_DID=
# APP_URL=
# NEXT_PUBLIC_BASE_URL=

# --- Set by the platform, never by hand ---
# NEXT_RUNTIME  injected by Next.js (instrumentation.ts checks it)
