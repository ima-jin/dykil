{
  "name": "dykil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "import-legacy": "tsx scripts/import-legacy.ts",
    "check-env": "node scripts/check-env.mjs",
    "baseline": "node --env-file=.env.local scripts/legacy-baseline.mjs",
    "deploy:dev": "scripts/deploy.sh dev",
    "deploy:prod": "scripts/deploy.sh prod"
  },
  "dependencies": {
    "@ima-jin/auth": "^0.8.7",
    "@ima-jin/auth-client": "^0.8.8",
    "@ima-jin/config": "^0.8.0",
    "@ima-jin/logger": "^0.8.7",
    "@ima-jin/ui": "^0.8.0",
    "next": "^15.5.24",
    "pg": "^8.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "survey-core": "^2.5.13",
    "survey-react-ui": "^2.5.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^30.1.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@ima-jin/config": "0.8.0"
    }
  }
}
